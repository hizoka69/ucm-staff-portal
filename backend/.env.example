# Variables de entorno - Backend UCM Staff API (copiar a .env y completar valores reales)
ENV=development

# Conexión Oracle 21c XE local (o Oracle Cloud Autonomous DB)
ORACLE_USER=UCM_STAFF_BD
ORACLE_PASSWORD=<TU_PASSWORD_ORACLE>
ORACLE_DSN=localhost:1521/XEPDB1

# Opcional: solo si se conecta a Oracle Cloud Autonomous DB mediante Wallet mTLS
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# Seguridad JWT (generar una clave aleatoria larga en producción)
JWT_SECRET=<CAMBIAR_POR_SECRETO_JWT_SEGURO>

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
